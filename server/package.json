{
  "name": "server",
  "version": "0.4.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "BUN_ENV=development bun --env-file=.env.development --watch index.ts",
    "start": "BUN_ENV=production bun --env-file=.env.production scripts/clear-port.ts && BUN_ENV=production bun --env-file=.env.production index.ts",
    "db:push": "BUN_ENV=development bun --env-file=.env.development x --bun drizzle-kit push",
    "db:push:test": "BUN_ENV=test bun --env-file=.env.test x --bun drizzle-kit push --config=drizzle.config.test.ts",
    "db:migrate": "BUN_ENV=development bun --env-file=.env.development x --bun drizzle-kit migrate",
    "db:migrate:test": "BUN_ENV=test bun --env-file=.env.test x --bun drizzle-kit migrate --config=drizzle.config.test.ts",
    "db:studio": "BUN_ENV=development bun --env-file=.env.development x --bun drizzle-kit studio",
    "db:studio:test": "BUN_ENV=test bun --env-file=.env.test x --bun drizzle-kit studio --config=drizzle.config.test.ts",
    "db:generate": "BUN_ENV=development bun --env-file=.env.development x --bun drizzle-kit generate",
    "db:reset": "bun --env-file=.env.development run scripts/db-reset.ts",
    "db:reset:test": "BUN_ENV=test bun --env-file=.env.test scripts/db-reset.ts",
    "format": "bun x --bun prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "bun x --bun prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "bun x --bun tsc --noEmit",
    "test": "BUN_ENV=test bun test --env-file=.env.test",
    "test:evidence": "bun scripts/test-evidence.ts",
    "evidence:all": "bun ../scripts/evidence-all.ts",
    "test:coverage": "BUN_ENV=test bun test --env-file=.env.test --coverage --coverage-skip-test-files",
    "quality": "bun run format:check && bun run typecheck && bun run test:coverage"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.4.2",
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "drizzle-orm": "^0.44.0",
    "drizzle-seed": "^0.3.1",
    "hono": "^4.12.15",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^4.3.6"
  }
}
